{
	"name": "vuepress-theme-hope-template",
	"version": "2.0.0",
	"description": "A project of vuepress-theme-hope",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"docs:build": "vuepress build .",
		"build": "vuepress build --dest .dist .",
		"docs:clean-dev": "vuepress dev . --clean-cache",
		"docs:dev": "vuepress dev .",
		"dev": "vuepress dev .",
		"dev-debug": "vuepress dev --debug .",
		"docs:update-package": "npx vp-update",
		"offline": "node ./.vuepress/offline.cjs .dist-offline",
		"docs:webpack":"vuepress build --config ./.vuepress/config-offline.ts --dest dist-offline .",
		"docs:offline": "vuepress build --config ./.vuepress/config-offline.ts --dest dist-offline . && npm run offline"
	},
	"dependencies": {
		"@vuepress/bundler-vite": "2.0.0-rc.9",
		"@vuepress/bundler-webpack": "^2.0.0-rc.9",
		"@vuepress/plugin-search": "^2.0.0-rc.26",
		"css": "^3.0.0",
		"is-absolute-url": "^3.0.3",
		"is-url": "^1.2.4",
		"katex": "^0.16.10",
		"mathjax-full": "^3.2.2",
		"sass-loader": "^14.2.1",
		"vue": "^3.4.23",
		"vuepress": "2.0.0-rc.9",
		"vuepress-plugin-search-pro": "^2.0.0-rc.37",
		"vuepress-theme-hope": "2.0.0-rc.37",
		"walk": "^2.3.15"
	}
}
