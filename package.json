{
	"name": "vuepress-theme-hope-template",
	"version": "2.0.0",
	"description": "A project of vuepress-theme-hope",
	"license": "MIT",
	"scripts": {
		"update-package": "npx vp-update",
		"clean-dev": "vuepress dev . --clean-cache",
		"dev": "vuepress dev .",
		"dev:gitlab": "vuepress dev --config ./.vuepress/config-gitlab.ts .",
		"dev-debug": "vuepress dev --debug .",
		"build:online": "vuepress build --config ./.vuepress/config-online.ts  --dest .dist/online .",
		"build:standalone": "vuepress build --config ./.vuepress/config-standalone.ts --dest .dist/standalone . && npm run script:standalone",
		"build:standalone-kylin": "vuepress build --config ./.vuepress/config-standalone-kylin.ts --dest .dist/standalone-kylin . && npm run script:standalone-kylin",
		"build:gitlab": "vuepress build --config ./.vuepress/config-gitlab.ts --dest .dist/gitlab .",
		"script:standalone": "node ./.vuepress/standalone.cjs .dist/standalone",
		"script:standalone-kylin": "node ./.vuepress/standalone.cjs .dist/standalone-kylin",
		"postinstall": "patch-package"
	},
	"dependencies": {
		"@vuepress/bundler-vite": "2.0.0-rc.9",
		"@vuepress/bundler-webpack": "^2.0.0-rc.9",
		"@vuepress/plugin-redirect": "^2.0.0-rc.26",
		"@vuepress/plugin-rtl": "^2.0.0-rc.26",
		"@vuepress/plugin-search": "^2.0.0-rc.26",
		"css": "^3.0.0",
		"is-absolute-url": "^3.0.3",
		"is-url": "^1.2.4",
		"katex": "^0.16.10",
		"mathjax-full": "^3.2.2",
		"node-fetch": "^3.3.2",
		"sass-loader": "^14.2.1",
		"vue": "^3.4.23",
		"vuepress": "^2.0.0-rc.9",
		"vuepress-plugin-search-pro": "^2.0.0-rc.37",
		"vuepress-theme-hope": "2.0.0-rc.37",
		"walk": "^2.3.15"
	},
	"devDependencies": {
		"@babel/core": "^7.28.4",
		"@babel/preset-env": "^7.28.3",
		"@mdit/plugin-include": "^0.23.2",
		"@vue/babel-preset-app": "^5.0.9",
		"babel-loader": "^10.0.0",
		"patch-package": "^8.0.1"
	},
	"browerslist": [
		"> 1%",
		"last 2 version",
		"not ie <= 8",
		"firefox >= 52"
	]
}
